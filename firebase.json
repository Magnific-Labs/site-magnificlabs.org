{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "cleanUrls": false,
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about.html",
        "destination": "/about/",
        "type": 301
      },
      {
        "source": "/blog.html",
        "destination": "/blog/",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/contact/",
        "type": 301
      },
      {
        "source": "/privacy.html",
        "destination": "/privacy/",
        "type": 301
      },
      {
        "source": "/terms.html",
        "destination": "/terms/",
        "type": 301
      },
      {
        "source": "/post.html",
        "destination": "/blog/",
        "type": 301
      }
    ],
    "headers": [
      {
        "comment": "Default for pages and htmx fragments: clean URLs like /about/ do not match a *.html glob, so this has to be the catch-all. Overridden below for hashed assets.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "comment": "Content-hashed by the build, so a change is a new URL and these can never go stale.",
        "source": "/@(styles|scripts|vendor)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
